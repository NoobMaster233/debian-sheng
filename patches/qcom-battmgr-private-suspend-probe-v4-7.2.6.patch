From 3bb33b1e8fcd4053c8ff779187d4ab9e30953749 Mon Sep 17 00:00:00 2001
From: sheng maintenance research <noreply@local>
Date: Mon, 21 Sep 2026 22:40:00 +0800
Subject: [PATCH] power: supply: qcom_battmgr: add bounded suspend probes

Add fixed ten-second diagnostics for Xiaomi input_suspend and
charging_suspend_battery after the bounded FCC-zero experiment changed the
reported limit but did not change physical charging.

Each root-only trigger requires a zero baseline, schedules restoration
before writing one, verifies SET and GET results, and restores zero through
timeout, manual request, retry, service return, removal, or shutdown. Tests
are mutually exclusive with the existing FCC probe.
---
 drivers/power/supply/qcom_battmgr.c | 318 +++++++++++++++++++++++++++-
 1 file changed, 315 insertions(+), 3 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 18e6c7a..7a08496 100755
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -28,6 +28,7 @@
 #define BATTMGR_FCC_RESTORE_MAX_ATTEMPTS	30
 #define BATTMGR_FCC_TEST_MIN_UA		100000
 #define BATTMGR_FCC_TEST_MAX_UA		10000000
+#define BATTMGR_PRIVATE_TEST_DURATION_MS	10000
 
 enum qcom_battmgr_variant {
 	QCOM_BATTMGR_SC8280XP,
@@ -149,6 +150,7 @@ enum qcom_battmgr_variant {
 #define XM_BATT_BQ2597X_BATTERY_PRESENT		0x21
 #define XM_BATT_BQ2597X_SLAVE_BATTERY_PRESENT	0x22
 #define XM_BATT_BQ2597X_BATTERY_VOLTAGE		0x23
+#define XM_BATT_INPUT_SUSPEND			0x2a
 #define XM_BATT_FASTCHGMODE			0x2b
 #define XM_BATT_NIGHT_CHARGING			0x2c
 #define XM_BATT_QUICK_CHARGE_TYPE		0x31
@@ -440,6 +442,22 @@ struct qcom_battmgr {
 	int fcc_test_restore_read_result;
 	int fcc_test_restore_result;
 	unsigned int fcc_test_restore_attempts;
+	struct delayed_work private_restore_work;
+	/* Serialize the private-property test and its restoration. */
+	struct mutex private_test_lock;
+	bool private_test_active;
+	u32 private_test_property;
+	u32 private_test_value;
+	u32 private_test_restore_value;
+	u32 private_test_after_set_value;
+	u32 private_test_before_restore_value;
+	u32 private_test_after_restore_value;
+	int private_test_set_result;
+	int private_test_set_read_result;
+	int private_test_restore_set_result;
+	int private_test_restore_read_result;
+	int private_test_restore_result;
+	unsigned int private_test_restore_attempts;
 
 	struct work_struct enable_work;
 
@@ -639,6 +657,96 @@ static int qcom_battmgr_xiaomi_request_property(struct qcom_battmgr *battmgr, in
 	return ret;
 }
 
+static int qcom_battmgr_get_xiaomi_property(struct qcom_battmgr *battmgr,
+					    u32 property, u32 *value)
+{
+	return qcom_battmgr_xiaomi_request_property(battmgr,
+						      BATTMGR_XM_PROPERTY_GET,
+						      property, 0, value);
+}
+
+static int qcom_battmgr_set_xiaomi_property(struct qcom_battmgr *battmgr,
+					    u32 property, u32 value)
+{
+	return qcom_battmgr_xiaomi_request_property(battmgr,
+						      BATTMGR_XM_PROPERTY_SET,
+						      property, value, NULL);
+}
+
+static int qcom_battmgr_restore_private_locked(struct qcom_battmgr *battmgr)
+{
+	u32 property = battmgr->private_test_property;
+	u32 restore_value = battmgr->private_test_restore_value;
+	u32 value;
+	int read_ret;
+	int ret;
+
+	ret = qcom_battmgr_get_xiaomi_property(battmgr, property, &value);
+	if (!ret)
+		battmgr->private_test_before_restore_value = value;
+
+	ret = qcom_battmgr_set_xiaomi_property(battmgr, property, restore_value);
+	battmgr->private_test_restore_set_result = ret;
+
+	read_ret = qcom_battmgr_get_xiaomi_property(battmgr, property, &value);
+	battmgr->private_test_restore_read_result = read_ret;
+	if (!read_ret)
+		battmgr->private_test_after_restore_value = value;
+
+	if (!read_ret && value == restore_value) {
+		battmgr->private_test_active = false;
+		ret = 0;
+		goto out_result;
+	}
+
+	if (!ret)
+		ret = read_ret ? read_ret : -EIO;
+
+out_result:
+	battmgr->private_test_restore_result = ret;
+	return ret;
+}
+
+static void qcom_battmgr_private_restore_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work),
+						       struct qcom_battmgr,
+						       private_restore_work);
+	int ret;
+
+	mutex_lock(&battmgr->private_test_lock);
+	if (!battmgr->private_test_active)
+		goto out_unlock;
+
+	battmgr->private_test_restore_attempts++;
+	ret = qcom_battmgr_restore_private_locked(battmgr);
+	if (!ret) {
+		dev_info(battmgr->dev,
+			 "private probe property %#x restored to %u\n",
+			 battmgr->private_test_property,
+			 battmgr->private_test_after_restore_value);
+		goto out_unlock;
+	}
+
+	if (battmgr->private_test_restore_attempts <
+	    BATTMGR_FCC_RESTORE_MAX_ATTEMPTS) {
+		dev_warn(battmgr->dev,
+			 "private probe property %#x restore attempt %u failed: %d; retrying\n",
+			 battmgr->private_test_property,
+			 battmgr->private_test_restore_attempts, ret);
+		mod_delayed_work(system_wq, &battmgr->private_restore_work,
+				 msecs_to_jiffies(BATTMGR_FCC_RESTORE_RETRY_MS));
+	} else {
+		dev_crit(battmgr->dev,
+			 "private probe property %#x restore failed after %u attempts: %d\n",
+			 battmgr->private_test_property,
+			 battmgr->private_test_restore_attempts, ret);
+	}
+
+out_unlock:
+	mutex_unlock(&battmgr->private_test_lock);
+}
+
 int qcom_battmgr_set_keyboard_plugin(bool attached)
 {
 	struct qcom_battmgr *battmgr;
@@ -1607,7 +1715,7 @@ static ssize_t probe_fcc_zero_test_store(struct device *dev,
 		return -EINVAL;
 
 	mutex_lock(&battmgr->fcc_test_lock);
-	if (battmgr->fcc_test_active) {
+	if (battmgr->fcc_test_active || READ_ONCE(battmgr->private_test_active)) {
 		ret = -EBUSY;
 		goto out_unlock;
 	}
@@ -1692,9 +1800,165 @@ out_unlock:
 	return ret ? ret : count;
 }
 
+static ssize_t probe_private_test_status_show(struct device *dev,
+					      struct device_attribute *attr,
+					      char *buf)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&battmgr->private_test_lock);
+	len = sysfs_emit(buf, "active=%u property=%#x test=%u restore=%u\n",
+			 battmgr->private_test_active,
+			 battmgr->private_test_property,
+			 battmgr->private_test_value,
+			 battmgr->private_test_restore_value);
+	len += sysfs_emit_at(buf, len, "set_result=%d set_read_result=%d after_set=%u\n",
+			 battmgr->private_test_set_result,
+			 battmgr->private_test_set_read_result,
+			 battmgr->private_test_after_set_value);
+	len += sysfs_emit_at(buf, len,
+			     "before_restore=%u restore_result=%d\n",
+			     battmgr->private_test_before_restore_value,
+			     battmgr->private_test_restore_result);
+	len += sysfs_emit_at(buf, len,
+			     "restore_set_result=%d restore_read_result=%d\n",
+			     battmgr->private_test_restore_set_result,
+			     battmgr->private_test_restore_read_result);
+	len += sysfs_emit_at(buf, len, "after_restore=%u attempts=%u\n",
+			     battmgr->private_test_after_restore_value,
+			     battmgr->private_test_restore_attempts);
+	mutex_unlock(&battmgr->private_test_lock);
+
+	return len;
+}
+
+static ssize_t qcom_battmgr_private_test_store(struct device *dev,
+					       u32 property, u32 test_value,
+					       u32 restore_value,
+					       const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	u32 trigger;
+	u32 value;
+	int read_ret;
+	int ret;
+
+	ret = kstrtou32(buf, 0, &trigger);
+	if (ret)
+		return ret;
+	if (trigger != 1)
+		return -EINVAL;
+
+	mutex_lock(&battmgr->private_test_lock);
+	if (battmgr->private_test_active || READ_ONCE(battmgr->fcc_test_active)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	ret = qcom_battmgr_get_xiaomi_property(battmgr, property, &value);
+	if (ret)
+		goto out_unlock;
+	if (value != restore_value) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	battmgr->private_test_property = property;
+	battmgr->private_test_value = test_value;
+	battmgr->private_test_restore_value = restore_value;
+	battmgr->private_test_after_set_value = U32_MAX;
+	battmgr->private_test_before_restore_value = U32_MAX;
+	battmgr->private_test_after_restore_value = U32_MAX;
+	battmgr->private_test_set_result = -EINPROGRESS;
+	battmgr->private_test_set_read_result = -EINPROGRESS;
+	battmgr->private_test_restore_set_result = -EINPROGRESS;
+	battmgr->private_test_restore_read_result = -EINPROGRESS;
+	battmgr->private_test_restore_result = -EINPROGRESS;
+	battmgr->private_test_restore_attempts = 0;
+	battmgr->private_test_active = true;
+
+	mod_delayed_work(system_wq, &battmgr->private_restore_work,
+			 msecs_to_jiffies(BATTMGR_PRIVATE_TEST_DURATION_MS));
+
+	ret = qcom_battmgr_set_xiaomi_property(battmgr, property, test_value);
+	battmgr->private_test_set_result = ret;
+	read_ret = qcom_battmgr_get_xiaomi_property(battmgr, property, &value);
+	battmgr->private_test_set_read_result = read_ret;
+	if (!read_ret)
+		battmgr->private_test_after_set_value = value;
+
+	if (ret || read_ret || value != test_value) {
+		mod_delayed_work(system_wq, &battmgr->private_restore_work, 0);
+		if (!ret)
+			ret = read_ret ? read_ret : -EIO;
+		goto out_unlock;
+	}
+
+	dev_info(battmgr->dev,
+		 "private probe property %#x=%u armed for %u ms; restore=%u\n",
+		 property, test_value, BATTMGR_PRIVATE_TEST_DURATION_MS,
+		 restore_value);
+	ret = 0;
+
+out_unlock:
+	mutex_unlock(&battmgr->private_test_lock);
+	return ret ? ret : count;
+}
+
+static ssize_t probe_input_suspend_test_store(struct device *dev,
+					      struct device_attribute *attr,
+					      const char *buf, size_t count)
+{
+	return qcom_battmgr_private_test_store(dev, XM_BATT_INPUT_SUSPEND,
+						  1, 0, buf, count);
+}
+
+static ssize_t probe_charging_suspend_test_store(struct device *dev,
+						 struct device_attribute *attr,
+						 const char *buf, size_t count)
+{
+	u32 property = XM_BATT_CHARGING_SUSPEND_BATTERY;
+
+	return qcom_battmgr_private_test_store(dev, property, 1, 0, buf, count);
+}
+
+static ssize_t probe_private_restore_now_store(struct device *dev,
+					       struct device_attribute *attr,
+					       const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	u32 trigger;
+	int ret;
+
+	ret = kstrtou32(buf, 0, &trigger);
+	if (ret)
+		return ret;
+	if (trigger != 1)
+		return -EINVAL;
+
+	mutex_lock(&battmgr->private_test_lock);
+	if (!battmgr->private_test_active) {
+		ret = -EALREADY;
+		goto out_unlock;
+	}
+
+	battmgr->private_test_restore_attempts = 0;
+	mod_delayed_work(system_wq, &battmgr->private_restore_work, 0);
+	ret = 0;
+
+out_unlock:
+	mutex_unlock(&battmgr->private_test_lock);
+	return ret ? ret : count;
+}
+
 static DEVICE_ATTR_RO(probe_fcc_test_status);
 static DEVICE_ATTR_WO(probe_fcc_zero_test);
 static DEVICE_ATTR_WO(probe_fcc_restore_now);
+static DEVICE_ATTR_RO(probe_private_test_status);
+static DEVICE_ATTR_WO(probe_input_suspend_test);
+static DEVICE_ATTR_WO(probe_charging_suspend_test);
+static DEVICE_ATTR_WO(probe_private_restore_now);
 
 #define QCOM_BATTMGR_BATTERY_PROBE_ATTR_RO(_name, _prop)		\
 	static struct qcom_battmgr_battery_probe_attr qcom_battmgr_battery_probe_attr_##_name = { \
@@ -1772,6 +2036,8 @@ QCOM_BATTMGR_XIAOMI_ATTR_RO(probe_charging_suspend_battery,
 			    QCOM_BATTMGR_XIAOMI_DEC);
 QCOM_BATTMGR_XIAOMI_ATTR_RO(probe_enable_charging, XM_BATT_ENABLE_CHARGING,
 			    QCOM_BATTMGR_XIAOMI_DEC);
+QCOM_BATTMGR_XIAOMI_ATTR_RO(probe_input_suspend, XM_BATT_INPUT_SUSPEND,
+			    QCOM_BATTMGR_XIAOMI_DEC);
 QCOM_BATTMGR_BATTERY_PROBE_ATTR_RO(probe_charge_control_limit, BATT_CHG_CTRL_LIM);
 QCOM_BATTMGR_BATTERY_PROBE_ATTR_RO(probe_charge_control_limit_max,
 				   BATT_CHG_CTRL_LIM_MAX);
@@ -1817,12 +2083,17 @@ static struct attribute *qcom_battmgr_xiaomi_attrs[] = {
 	&qcom_battmgr_xiaomi_attr_probe_smart_chg.dev_attr.attr,
 	&qcom_battmgr_xiaomi_attr_probe_charging_suspend_battery.dev_attr.attr,
 	&qcom_battmgr_xiaomi_attr_probe_enable_charging.dev_attr.attr,
+	&qcom_battmgr_xiaomi_attr_probe_input_suspend.dev_attr.attr,
 	&qcom_battmgr_battery_probe_attr_probe_charge_control_limit.dev_attr.attr,
 	&qcom_battmgr_battery_probe_attr_probe_charge_control_limit_max.dev_attr.attr,
 	&qcom_battmgr_battery_probe_attr_probe_constant_charge_current.dev_attr.attr,
 	&dev_attr_probe_fcc_test_status.attr,
 	&dev_attr_probe_fcc_zero_test.attr,
 	&dev_attr_probe_fcc_restore_now.attr,
+	&dev_attr_probe_private_test_status.attr,
+	&dev_attr_probe_input_suspend_test.attr,
+	&dev_attr_probe_charging_suspend_test.attr,
+	&dev_attr_probe_private_restore_now.attr,
 	&qcom_battmgr_xiaomi_attr_fg_fastcharge.dev_attr.attr,
 	&qcom_battmgr_xiaomi_attr_slave_authentic.dev_attr.attr,
 	&qcom_battmgr_xiaomi_attr_pps_ptf.dev_attr.attr,
@@ -2735,6 +3006,8 @@ static void qcom_battmgr_pdr_notify(void *priv, int state)
 		schedule_work(&battmgr->enable_work);
 		if (READ_ONCE(battmgr->fcc_test_active))
 			mod_delayed_work(system_wq, &battmgr->fcc_restore_work, 0);
+		if (READ_ONCE(battmgr->private_test_active))
+			mod_delayed_work(system_wq, &battmgr->private_restore_work, 0);
 	} else {
 		battmgr->service_up = false;
 	}
@@ -2782,6 +3055,7 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 
 	mutex_init(&battmgr->lock);
 	mutex_init(&battmgr->fcc_test_lock);
+	mutex_init(&battmgr->private_test_lock);
 	init_completion(&battmgr->ack);
 	battmgr->fcc_test_after_set_ua = U32_MAX;
 	battmgr->fcc_test_before_restore_ua = U32_MAX;
@@ -2791,6 +3065,14 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	battmgr->fcc_test_restore_set_result = -ENODATA;
 	battmgr->fcc_test_restore_read_result = -ENODATA;
 	battmgr->fcc_test_restore_result = -ENODATA;
+	battmgr->private_test_after_set_value = U32_MAX;
+	battmgr->private_test_before_restore_value = U32_MAX;
+	battmgr->private_test_after_restore_value = U32_MAX;
+	battmgr->private_test_set_result = -ENODATA;
+	battmgr->private_test_set_read_result = -ENODATA;
+	battmgr->private_test_restore_set_result = -ENODATA;
+	battmgr->private_test_restore_read_result = -ENODATA;
+	battmgr->private_test_restore_result = -ENODATA;
 
 	match = of_match_device(qcom_battmgr_of_variants, dev->parent);
 	if (match)
@@ -2808,6 +3090,10 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 						   qcom_battmgr_fcc_restore_worker);
 		if (ret)
 			return ret;
+		ret = devm_delayed_work_autocancel(dev, &battmgr->private_restore_work,
+						   qcom_battmgr_private_restore_worker);
+		if (ret)
+			return ret;
 
 		ret = devm_device_add_group(dev, &qcom_battmgr_xiaomi_attr_group);
 		if (ret < 0)
@@ -2909,14 +3195,40 @@ static void qcom_battmgr_finish_fcc_probe(struct qcom_battmgr *battmgr)
 	mutex_unlock(&battmgr->fcc_test_lock);
 }
 
+static void qcom_battmgr_finish_private_probe(struct qcom_battmgr *battmgr)
+{
+	int ret;
+
+	if (battmgr->variant != XIAOMI_BATTMGR_SM8550)
+		return;
+
+	cancel_delayed_work_sync(&battmgr->private_restore_work);
+
+	mutex_lock(&battmgr->private_test_lock);
+	if (battmgr->private_test_active) {
+		ret = qcom_battmgr_restore_private_locked(battmgr);
+		if (ret)
+			dev_crit(battmgr->dev,
+				 "failed to restore private property %#x while stopping driver: %d\n",
+				 battmgr->private_test_property, ret);
+	}
+	mutex_unlock(&battmgr->private_test_lock);
+}
+
 static void qcom_battmgr_remove(struct auxiliary_device *adev)
 {
-	qcom_battmgr_finish_fcc_probe(dev_get_drvdata(&adev->dev));
+	struct qcom_battmgr *battmgr = dev_get_drvdata(&adev->dev);
+
+	qcom_battmgr_finish_private_probe(battmgr);
+	qcom_battmgr_finish_fcc_probe(battmgr);
 }
 
 static void qcom_battmgr_shutdown(struct auxiliary_device *adev)
 {
-	qcom_battmgr_finish_fcc_probe(dev_get_drvdata(&adev->dev));
+	struct qcom_battmgr *battmgr = dev_get_drvdata(&adev->dev);
+
+	qcom_battmgr_finish_private_probe(battmgr);
+	qcom_battmgr_finish_fcc_probe(battmgr);
 }
 
 static const struct auxiliary_device_id qcom_battmgr_id_table[] = {
